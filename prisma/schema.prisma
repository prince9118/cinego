generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  name     String
  role     UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}

enum ShowSeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

model City {
  id        String    @id @default(uuid())
  name      String
  state     String
  theatres  Theatre[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, state])
}

model Theatre {
  id        String   @id @default(uuid())
  name      String
  address   String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  screens   Screen[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
}

model Screen {
  id        String   @id @default(uuid())
  name      String
  theatreId String
  theatre   Theatre  @relation(fields: [theatreId], references: [id])
  seats     Seat[]
  show      Show[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([theatreId, name])
  @@index([theatreId])
}

model Seat {
  id     String   @id @default(uuid())
  row    String
  number Int
  type   SeatType @default(REGULAR)

  screenId  String
  screen    Screen     @relation(fields: [screenId], references: [id])
  showSeats ShowSeat[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([screenId, row, number])
  @@index([screenId])
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    Int
  language    String
  genre       String
  releaseDate DateTime
  shows       Show[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}

model Show {
  id       String @id @default(uuid())
  movieId  String
  movie    Movie  @relation(fields: [movieId], references: [id])
  screenId String
  screen   Screen @relation(fields: [screenId], references: [id])

  startTime DateTime
  endTime   DateTime
  showSeats ShowSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([screenId])
  @@index([startTime])
}

model ShowSeat {
  id String @id @default(uuid())

  showId String
  show   Show           @relation(fields: [showId], references: [id])
  seatId String
  seat   Seat           @relation(fields: [seatId], references: [id])
  status ShowSeatStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showId, seatId])
  @@index([showId])
}
